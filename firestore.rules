rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Demandes de service : visibles uniquement par le client et le prestataire concernés
    match /demandes/{demandeId} {
      allow read: if request.auth != null &&
        (resource.data.clientId == request.auth.uid || resource.data.prestataireId == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'clientId', 'clientNom', 'prestataireId', 'prestataireNom', 'categorie',
          'titre', 'description', 'adresse', 'dateSouhaitee', 'urgence', 'budget',
          'statut', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.prestataireId != request.auth.uid &&
        request.resource.data.statut == 'en_attente' &&
        request.resource.data.categorie in ['Coiffure', 'Plomberie', 'Mécanique', 'Maçonnerie'] &&
        request.resource.data.titre is string && request.resource.data.titre.size() >= 5 &&
        request.resource.data.titre.size() <= 80 &&
        request.resource.data.description is string && request.resource.data.description.size() >= 15 &&
        request.resource.data.description.size() <= 1000 &&
        request.resource.data.adresse is string && request.resource.data.adresse.size() >= 3 &&
        request.resource.data.adresse.size() <= 120 &&
        request.resource.data.dateSouhaitee is string &&
        request.resource.data.urgence in ['normale', 'urgente'] &&
        (request.resource.data.budget == null || (request.resource.data.budget is number && request.resource.data.budget >= 0)) &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;

      // Seuls le statut et la date de mise à jour peuvent changer
      allow update: if request.auth != null &&
        (resource.data.clientId == request.auth.uid || resource.data.prestataireId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        // le client peut seulement annuler ; le prestataire fait avancer la demande
        (
          (resource.data.clientId == request.auth.uid && request.resource.data.statut == 'annulee' && resource.data.statut == 'en_attente') ||
          (resource.data.prestataireId == request.auth.uid && request.resource.data.statut == 'acceptee' && resource.data.statut == 'en_attente') ||
          (resource.data.prestataireId == request.auth.uid && request.resource.data.statut == 'refusee' && resource.data.statut == 'en_attente') ||
          (resource.data.prestataireId == request.auth.uid && request.resource.data.statut == 'en_cours' && resource.data.statut == 'acceptee') ||
          (resource.data.prestataireId == request.auth.uid && request.resource.data.statut == 'terminee' && resource.data.statut == 'en_cours')
        );

      allow delete: if false;

      // Messages d'une demande
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/demandes/$(demandeId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/demandes/$(demandeId)).data.prestataireId == request.auth.uid);

        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(['senderId', 'texte', 'createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.texte is string &&
          request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 1000 &&
          request.resource.data.createdAt == request.time &&
          get(/databases/$(database)/documents/demandes/$(demandeId)).data.statut in ['en_attente', 'acceptee', 'en_cours'] &&
          (get(/databases/$(database)/documents/demandes/$(demandeId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/demandes/$(demandeId)).data.prestataireId == request.auth.uid);

        allow update, delete: if false;
      }
    }
  }
}
